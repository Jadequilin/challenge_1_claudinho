# Copie para .env e preencha. O .env NUNCA vai para o Git.

# Supabase — Project Settings > API
# Apenas o host do projeto, sem barra e sem caminho no fim.
# Certo:  https://xxxxxxxx.supabase.co
# Errado: https://xxxxxxxx.supabase.co/rest/v1/   (o client ja acrescenta /rest/v1)
SUPABASE_URL=
SUPABASE_KEY=

# Ambiente da aplicacao: local | staging | production
APP_ENV=local

# LLM proprio: Ollama no Hugging Face Spaces (ver deploy/ollama-space/README.md).
# URL ate o /v1. Ex.: https://usuario-claudinho-llm.hf.space/v1
LLM_BASE_URL=
LLM_MODELO=qwen2.5:3b
# Token do Hugging Face (leitura), necessario quando o Space e privado.
LLM_API_KEY=
LLM_TIMEOUT_S=90

# Reservas externas, usadas so quando o LLM proprio falha. Nunca recebem dado de saude.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite
OPENAI_API_KEY=
# Segredo de assinatura dos JWTs do Supabase Auth (Project Settings > API > JWT Secret).
# Obrigatorio quando APP_ENV != local: sem ele a API aceitaria qualquer token.
SUPABASE_JWT_SECRET=

# Origens liberadas no CORS fora do ambiente local, em lista JSON.
# Obrigatorio quando APP_ENV != local: sem ela o navegador bloqueia as chamadas do app.
# Ex.: ORIGENS_PERMITIDAS=["https://claudinho.app"]
ORIGENS_PERMITIDAS=[]
