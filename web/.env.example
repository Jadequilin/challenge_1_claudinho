# Copie para .env.local e ajuste. O .env.local NUNCA vai para o Git.

# Base da API. Em desenvolvimento com mock ligado, este valor nao e usado.
VITE_API_URL=http://127.0.0.1:8000

# Liga o mock da API (MSW). Com "true", o app roda sem backend, sem Supabase e sem LLM.
# E assim que da para trabalhar nas telas sem depender do pipeline estar de pe.
VITE_API_MOCK=true

# Token mandado no cabecalho Authorization. Serve SO para desenvolvimento local, onde a
# API aceita qualquer token com APP_ENV=local.
# ATENCAO: tudo que comeca com VITE_ e embutido no bundle e fica visivel para qualquer
# visitante. Nunca coloque um token real aqui. O token de verdade vai vir do login
# anonimo do Supabase, em tempo de execucao.
VITE_API_TOKEN=token-de-desenvolvimento
